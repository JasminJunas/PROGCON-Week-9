    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="rainbowColors" type="String" array="True" size="7"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="&quot;Hello and welcome! Please enter color &quot; &amp; (i + 1) &amp;&quot; of the rainbow:&quot;" newline="True"/>
                <input variable="rainbowColors[i]"/>
            </for>
        </body>
    </function>
